# ─────────────────────────────────────────────────────────────────────
# 2kFX ROBOT — example environment. Copy to `backend/.env` and fill in.
# NEVER commit a real .env file. NEVER put broker passwords in here —
# broker credentials are entered in the UI and stored encrypted.
# ─────────────────────────────────────────────────────────────────────

# development | test | production
APP_ENV=development
LOG_LEVEL=INFO
# json (machine-readable, default) | console (human-readable dev output)
LOG_FORMAT=console

# MySQL 8.x (SQLAlchemy URL, PyMySQL driver). Always keep charset=utf8mb4.
# `make db` creates the database if it does not exist.
DATABASE_URL=mysql+pymysql://root@127.0.0.1:3306/fxrobot?charset=utf8mb4

# Fernet key used to encrypt broker credentials at rest.
# `make setup` / `make env` generate one automatically. Manual: .venv/bin/fxrobot generate-key
# Losing this key makes stored broker credentials unrecoverable.
SECRET_ENCRYPTION_KEY=

# Session cookies. Must be true in production (HTTPS only).
COOKIE_SECURE=false
SESSION_TTL_MINUTES=720
SESSION_IDLE_TIMEOUT_MINUTES=60

# Login brute-force protection (per IP and per email)
LOGIN_RATE_LIMIT_ATTEMPTS=5
LOGIN_RATE_LIMIT_WINDOW_SECONDS=900

# Comma-separated origins allowed to call the API directly (the dashboard
# normally goes through the Next.js same-origin proxy, so this can stay empty).
CORS_ORIGINS=

# Peers allowed to set X-Forwarded-For (the Next.js server). Used for the
# client IP in audit logs and login rate limiting.
TRUSTED_PROXIES=127.0.0.1,::1

# Trading engine (runs inside the API process). Tick = how often it reconciles
# with brokers and evaluates strategies on newly closed bars.
ENGINE_ENABLED=true
ENGINE_TICK_SECONDS=2
# Background workers for backtests.
BACKTEST_WORKERS=1

# ── LIVE TRADING HARD LOCK ───────────────────────────────────────────
# While false, the system refuses to enter LIVE mode no matter what the
# UI or API requests. Leave false until Phase 10 live-readiness review.
LIVE_TRADING_ENABLED=false
