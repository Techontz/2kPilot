# 2kPilot — Laravel backend (API, auth, orchestration).
# Copy to .env and run:  php artisan key:generate && php artisan tp:keys
# Never commit .env. Secrets below are placeholders.

APP_NAME=2kPilot
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8421
# Where the Next.js dashboard is served (used for redirects, e.g. after Deriv sign-in).
FRONTEND_URL=http://localhost:3421

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=info

# MySQL 8 is the primary database. Laravel owns the schema (php artisan migrate).
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=tradepilot
DB_USERNAME=root
DB_PASSWORD=

# Cookie sessions for the dashboard (Sanctum SPA authentication).
SESSION_DRIVER=database
SESSION_COOKIE=tradepilot_session
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax
SANCTUM_STATEFUL_DOMAINS=localhost:3421,127.0.0.1:3421,localhost:3000

# Queues (Horizon: backtests, notifications) and cache run on Redis.
QUEUE_CONNECTION=redis
CACHE_STORE=redis
REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
MAIL_MAILER=log

# ── Trading safety ────────────────────────────────────────────────
# Hard lock: while false, nothing can ever trade on a LIVE (real-money) account.
LIVE_TRADING_ENABLED=false

# ── Users ─────────────────────────────────────────────────────────
# Public sign-up at /signup (false: only `php artisan tp:user` creates users).
TP_REGISTRATION_ENABLED=true
# true: every user must enrol in two-factor authentication before using the
# dashboard. MFA is always required for LIVE mode.
TP_REQUIRE_MFA=false
# Failed sign-ins allowed per email in 15 minutes (a correct password that
# still needs the two-factor code counts too), and per client IP across all
# emails (higher: many people can share one office / proxy IP).
TP_LOGIN_ATTEMPTS=5
TP_LOGIN_ATTEMPTS_PER_IP=50
# Proxies whose X-Forwarded-For is believed (comma-separated IPs/CIDRs): the
# Next.js server's address. 127.0.0.1 on one machine; the Docker network
# (e.g. 172.16.0.0/12) under docker compose. Never "*". See docs/DEPLOYMENT.md.
TRUSTED_PROXIES=127.0.0.1,::1

# ── Live updates (Server-Sent Events, GET /api/stream) ───────────
# Each open dashboard tab holds one PHP worker for up to this many seconds,
# then the browser reconnects. Keep it below your proxy's read timeout.
TP_STREAM_MAX_SECONDS=55
# Requests per user per minute (dashboard API / live-stream reconnects).
TP_API_PER_MINUTE=300
TP_STREAM_PER_MINUTE=60

# ── Broker credentials ───────────────────────────────────────────
# 32-byte key (base64) used to encrypt broker tokens/passwords (AES-256-GCM).
# Must be identical in trading-engine/.env. Generate with: php artisan tp:keys
BROKER_CREDENTIALS_KEY=

# ── Trading engine (Python service, internal only) ───────────────
ENGINE_URL=http://127.0.0.1:8431
# Shared HMAC secret for Laravel → engine requests (≥ 32 chars). Same value in trading-engine/.env.
ENGINE_API_SECRET=
ENGINE_TIMEOUT_SECONDS=30

# ── Deriv (https://developers.deriv.com) ─────────────────────────
# Register an app to get an app_id. Leave empty to hide the OAuth option;
# personal API tokens still work with the default public app id.
DERIV_APP_ID=
DERIV_OAUTH_REDIRECT_URL=http://localhost:3421/api/brokers/deriv/oauth/callback

# Plain-English strategy drafts allowed per user per hour (the engine needs ANTHROPIC_API_KEY).
AI_DRAFTS_PER_HOUR=10
