    {
      "slug": "ema-crossover",
      "name": "EMA crossover",
      "summary": "Buy when a fast EMA crosses above a slow EMA; sell on the opposite cross.",
      "details": {
        "how_it_works": "Two exponential moving averages follow the price at different speeds. When the fast EMA (9) crosses above the slow EMA (21), recent prices are rising faster than the longer average, which is read as upward momentum; the opposite cross is read as downward momentum. Each cross proposes one trade.",
        "struggles": "Sideways, choppy markets: the averages cross back and forth and produce many small losing trades. Crosses also come late, after part of the move has already happened.",
        "suggested_timeframe": "M5",
        "suggested_symbols": [
          "R_75",
          "R_100",
          "1HZ100V",
          "EURUSD",
          "GBPUSD",
          "USDJPY"
        ],
        "suggested_contract": {
          "contract_family": "RISE_FALL",
          "duration": 25,
          "duration_unit": "m"
        },
        "suggested_contract_note": "Rise/Fall lasting 5 M5 candles. On Paper accounts with forex symbols use Spot.",
        "difficulty": "beginner",
        "disclaimer": "Educational template: a starting point for learning and testing, not a recommendation and not claimed to be profitable. Backtest it and run it on a demo account first; past results do not predict future results."
