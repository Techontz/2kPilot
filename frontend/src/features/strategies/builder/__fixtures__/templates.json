 {
  "slug": "bollinger-reversion",
  "name": "Bollinger Bands reversion",
  "rules_text": "Buy when the close crosses above the lower Bollinger band (20, 2). Sell when the close crosses below the upper Bollinger band (20, 2). Close a buy early when the close is at or above the middle Bollinger band (20, 2). Close a sell early when the close is at or below the middle Bollinger band (20, 2). Stop: 2 × ATR 14 from the entry; target: 1.5 × the stop distance (Spot and Multiplier trades). Checked on every closed M5 bar.",
  "parameters": {
   "exit": {
    "stop": {
     "pips": null,
     "type": "atr",
     "multiple": 2,
     "atr_period": 14
    },
    "target": {
     "pips": null,
     "type": "rr",
     "ratio": 1.5,
     "multiple": 3,
     "atr_period": 14
    },
    "close_buy_when": {
     "all": null,
