# 2kFX MT5 bridge configuration. Copy to .env and fill in. Never commit .env.

# Shared HMAC secret (>= 32 chars). Must match the backend's MT5 bridge secret.
# Generate: python -c "import secrets;print(secrets.token_urlsafe(48))"
BRIDGE_SECRET=replace-me-with-a-long-random-secret-from-the-command-above

# Bind address/port. Keep 127.0.0.1 unless the backend reaches this host over a
# private network (Tailscale/WireGuard IP) or you enable TLS below.
BRIDGE_HOST=127.0.0.1
BRIDGE_PORT=8710

# Optional comma-separated client IPs/CIDRs allowed to call the bridge (empty = any).
BRIDGE_ALLOWED_IPS=

# Optional TLS (both required to enable HTTPS)
BRIDGE_SSL_CERTFILE=
BRIDGE_SSL_KEYFILE=

BRIDGE_LOG_LEVEL=INFO

# Path to terminal64.exe if more than one MT5 terminal is installed (optional)
MT5_TERMINAL_PATH=
# Magic number stamped on every order sent by the bridge
MT5_MAGIC=20250
# Default max slippage (points) for position closes
MT5_DEFAULT_DEVIATION_POINTS=20

# Trade-server UTC offset: "auto" (measured from live ticks) or fixed hours, e.g. +3 / +2
BROKER_SERVER_UTC_OFFSET=auto
# Liquid symbols used to measure the offset (broker suffixes are discovered automatically)
BROKER_OFFSET_SYMBOLS=EURUSD,GBPUSD,USDJPY,EURJPY,XAUUSD

# Idempotency journal (SQLite). Keep it on a persistent local disk and back it up.
JOURNAL_PATH=C:\mt5_bridge\data\journal.sqlite3

# Timeouts (seconds)
READ_TIMEOUT_SECONDS=10
TRADE_TIMEOUT_SECONDS=30
CONNECT_TIMEOUT_SECONDS=90
