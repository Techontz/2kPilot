# 2kPilot trading engine (Python) — internal service, called only by the Laravel backend.
# Copy to .env, then run `php artisan tp:keys` in backend/ to fill the two shared secrets.

APP_ENV=development
LOG_LEVEL=INFO
LOG_FORMAT=console

# Same MySQL database as backend/.env (Laravel creates the schema with `php artisan migrate`).
DATABASE_URL=mysql+pymysql://root@127.0.0.1:3306/tradepilot?charset=utf8mb4

# Internal API — keep it on loopback.
ENGINE_HOST=127.0.0.1
ENGINE_PORT=8431

# Shared with backend/.env (written by `php artisan tp:keys`). Never commit real values.
ENGINE_API_SECRET=
BROKER_CREDENTIALS_KEY=

# Hard lock: while false, nothing can trade on a LIVE (real-money) account.
LIVE_TRADING_ENABLED=false

# Run the automated trading loop in this process.
ENGINE_ENABLED=true
ENGINE_TICK_SECONDS=2

# Deriv App ID from developers.deriv.com (same value as DERIV_APP_ID in backend/.env).
DERIV_APP_ID=

# Optional: plain-English strategy drafting ("describe your strategy") with Claude.
# Leave empty to switch the feature off — templates and the rule builder still work.
# What is sent to Anthropic: the user's description, their optional symbol /
# timeframe / contract choice, and the rule catalogue. Never account data.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
